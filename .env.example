# --- Supabase (production persistence) ---
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- Owner auth ---
# Only this email can sign into /admin via Supabase magic link.
OWNER_EMAIL=

# --- App ---
# Public origin used in OAuth/PayPal redirects (e.g. https://chichis.example.com).
APP_URL=
BUSINESS_PHONE=
BUSINESS_TIMEZONE=Africa/Johannesburg

# --- PayPal ---
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_MODE=sandbox
# Public — exposed to the browser via Vite.
VITE_PAYPAL_CLIENT_ID=

# --- VALR (currently hidden in UI) ---
VALR_API_KEY=
VALR_API_SECRET=
VALR_PAY_ID=

# --- Google Calendar (service account) ---
# Paste the full JSON key contents from Google Cloud:
#   IAM → Service Accounts → <your account> → Keys → Add key → JSON
# The calendar identified by GOOGLE_CALENDAR_ID must be shared with the
# service account email (client_email field of the JSON) with
# "Make changes to events" permission.
GOOGLE_SERVICE_ACCOUNT_JSON=
GOOGLE_CALENDAR_ID=
