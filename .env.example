# --- Supabase (production persistence) ---
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- Owner auth ---
# Only this email can sign into /admin via Supabase magic link.
OWNER_EMAIL=

# --- App ---
# Public origin used in OAuth/PayPal redirects (e.g. https://chichis.example.com).
APP_URL=
BUSINESS_PHONE=
BUSINESS_TIMEZONE=Africa/Johannesburg

# --- PayPal ---
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_MODE=sandbox
# Public — exposed to the browser via Vite. In production a missing value
# disables card payments visibly (no silent sandbox fallback).
VITE_PAYPAL_CLIENT_ID=
# Webhook id from PayPal dashboard → Webhooks → {APP_URL}/api/paypal/webhook
# subscribed to PAYMENT.CAPTURE.COMPLETED. Reconciles captures the browser
# flow failed to record. Route returns 503 until this is set.
# NOTE: webhooks are per-app — the sandbox app and the live app each need
# their own webhook, with different ids. Swap this when switching to live.
PAYPAL_WEBHOOK_ID=

# --- PII encryption at rest (POPIA) ---
# 32 bytes, base64 (generate: openssl rand -base64 32). Customer name/phone
# are AES-256-GCM encrypted with this before hitting the DB. Do NOT rotate
# casually — old rows need the key they were written with.
PII_ENCRYPTION_KEY=

# --- Sentry (free tier; error monitoring) ---
# Server events (money-critical alert chokepoints). Optional — no-op unset.
SENTRY_DSN=
# Browser events (render errors, unhandled client exceptions). Public value.
VITE_SENTRY_DSN=

# --- Alerts (owner email on money-critical failures) ---
# Resend API key (resend.com → API Keys). Without it alerts only log.
RESEND_API_KEY=
# Defaults: ALERT_EMAIL falls back to OWNER_EMAIL; ALERT_FROM must be on the
# Resend-verified sending domain.
ALERT_EMAIL=
ALERT_FROM=

# --- VALR (currently hidden in UI) ---
VALR_API_KEY=
VALR_API_SECRET=
VALR_PAY_ID=

# --- Google Calendar (service account) ---
# Paste the full JSON key contents from Google Cloud:
#   IAM → Service Accounts → <your account> → Keys → Add key → JSON
# The calendar identified by GOOGLE_CALENDAR_ID must be shared with the
# service account email (client_email field of the JSON) with
# "Make changes to events" permission.
GOOGLE_SERVICE_ACCOUNT_JSON=
GOOGLE_CALENDAR_ID=
