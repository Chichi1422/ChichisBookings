# --- Supabase (production persistence) ---
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- Owner auth ---
# Only this email can sign into /admin via Supabase magic link.
OWNER_EMAIL=

# --- App ---
# Public origin used in OAuth/PayPal redirects (e.g. https://chichis.example.com).
APP_URL=
BUSINESS_PHONE=
BUSINESS_TIMEZONE=Africa/Johannesburg

# --- PayPal ---
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_MODE=sandbox
# Public — exposed to the browser via Vite.
VITE_PAYPAL_CLIENT_ID=

# --- VALR (currently hidden in UI) ---
VALR_API_KEY=
VALR_API_SECRET=
VALR_PAY_ID=

# --- Google Calendar ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Must match the redirect URI registered in Google Cloud.
GOOGLE_REDIRECT_URI=
GOOGLE_CALENDAR_ID=primary
